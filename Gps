<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>خريطة تفاعلية - GPS</title>
    <!-- استدعاء مكتبة Leaflet للخرائط -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            background-color: #121212;
            color: #fff;
        }
        #header {
            padding: 15px;
            text-align: center;
            background: #1e1e1e;
            font-size: 18px;
            font-weight: bold;
            box-shadow: 0 2px 5px rgba(0,0,0,0.5);
        }
        #map {
            width: 100%;
            height: calc(100vh - 60px);
        }
        .leaflet-popup-content-wrapper, .leaflet-popup-tip {
            background: #333;
            color: #fff;
        }
    </style>
</head>
<body>

    <div id="header">خريطة الموقع التفاعلية 🗺️</div>
    <div id="map"></div>

    <!-- استدعاء ملف JavaScript الخاص بالمكتبة -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        // إعداد الخريطة المبدئية (الإحداثيات الافتراضية على خط الاستواء أو أي نقطة)
        var map = L.map('map').setView([24.7136, 46.6753], 6);

        // إضافة طبقة الخريطة (تصميم قمر صناعي أو شوارع - هنا اخترنا تصميم شوارع تفاعلي فخم)
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        // محاولة جلب موقع المستخدم الحقيقي عبر الـ GPS
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function(position) {
                var lat = position.coords.latitude;
                var lon = position.coords.longitude;

                // تحريك الخريطة لموقع المستخدم ووضع علامة دقيقة
                map.setView([lat, lon], 15);
                L.marker([lat, lon]).addTo(map)
                    .bindPopup('أنت هنا حالياً 📍')
                    .openPopup();
            }, function(error) {
                console.log("تعذر تحديد الموقع تلقائياً، يرجى السماح للـ GPS بالعمل.");
            });
        }
    </script>
</body>
</html>

